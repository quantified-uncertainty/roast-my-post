{
  "name": "@roast/jobs",
  "version": "0.1.0",
  "private": true,
  "description": "Job processing package for RoastMyPost",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:ci": "vitest run",
    "process-pgboss": "tsx src/cli/process-pgboss-worker.ts"
  },
  "dependencies": {
    "@roast/ai": "workspace:*",
    "@roast/db": "workspace:*",
    "@roast/domain": "workspace:*",
    "dotenv": "^18.0.9",
    "pg-boss": "^12.38.0",
    "resend": "^6.34.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  }
}
