{
  "name": "@roast/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "dev:webpack": "next dev",
    "build": "pnpm --filter @roast/ai run check-schemas && pnpm --filter @roast/ai run check-readmes && next build",
    "start": "next start",
    "lint": "eslint . --config ./config/eslint/.eslintrc.json",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run lint",
    "test": "vitest run",
    "test:model": "vitest run --config vitest.model.config.ts",
    "test:unit": "vitest run --exclude=**/*.{integration,e2e,llm}.vtest.*",
    "test:integration": "vitest run --config vitest.integration.config.mjs **/*.integration.vtest.*",
    "test:e2e": "vitest run **/*.e2e.vtest.*",
    "test:llm": "vitest run **/*.llm.vtest.*",
    "test:fast": "vitest run --exclude=**/*.{e2e,llm}.vtest.*",
    "test:without-llms": "vitest run --exclude=**/*.llm.vtest.*",
    "test:without-external": "vitest run --exclude=**/*.{e2e,llm}.vtest.*",
    "test:ci": "vitest run --exclude=**/*.{integration,e2e,llm}.vtest.*",
    "test:ci-integration": "vitest run --config vitest.integration.config.mjs src/app/tools/__tests__/tool-examples.integration.vtest.ts src/app/api/tools/perplexity-research/route.integration.vtest.ts src/__tests__/integration/ai-package.integration.vtest.ts src/application/workflows/ephemeral-batch-cascade.integration.vtest.ts",
    "test:ci-nocov": "vitest run --exclude=**/*.{integration,e2e,llm}.vtest.*",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:shard": "vitest run --exclude=**/*.{e2e,llm}.test.*",
    "test:debug": "TEST_DEBUG=true vitest run",
    "typecheck:scripts": "tsc --project ./config/typescript/tsconfig.scripts.json",
    "test:scripts": "pnpm run typecheck:scripts && pnpm run test:scripts:smoke",
    "test:scripts:smoke": "echo 'Running script smoke tests...' && pnpm run test:scripts:runtime",
    "test:scripts:runtime": "echo 'Testing script runtime...' && timeout 5 pnpm run process-jobs:dry-run || echo 'Dry run completed'",
    "process-jobs": "pnpm --filter @roast/jobs run process-job",
    "process-jobs:dry-run": "dotenv -e .env.local -- tsx -e \"console.log('✅ Script dependencies load correctly'); process.exit(0)\"",
    "process-jobs-adaptive": "pnpm --filter @roast/jobs run process-adaptive",
    "cleanup-stale-jobs": "dotenv -e .env.local -- tsx src/scripts/cleanup-stale-jobs.ts",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "test:playwright:headed": "playwright test --headed",
    "test:playwright:debug": "playwright test --debug"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@auth/prisma-adapter": "^2.11.3",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^6.0.0",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@roast/ai": "workspace:*",
    "@roast/db": "workspace:*",
    "@roast/domain": "workspace:*",
    "@roast/jobs": "workspace:*",
    "axios": "^1.20.0",
    "chroma-js": "^3.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "diff-match-patch": "^1.0.5",
    "js-yaml": "^5.5.0",
    "jsdom": "^30.1.3",
    "lodash": "^4.18.1",
    "lucide-react": "^1.61.0",
    "markdown-truncate": "^1.1.1",
    "mathjs": "^15.2.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "next-safe-action": "^8.7.3",
    "next-themes": "^0.4.6",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-slate-transformer": "^0.12.1",
    "server-only": "^0.0.1",
    "slate": "^0.112.0",
    "slate-history": "^0.144.0",
    "slate-react": "^0.147.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "turndown": "^7.2.4",
    "unified": "^11.0.5",
    "use-debounce": "^10.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^7.29.7",
    "@playwright/test": "^1.64.1",
    "@prisma/nextjs-monorepo-workaround-plugin": "^7.10.1",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/chroma-js": "^3.1.3",
    "@types/diff-match-patch": "^1.0.36",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^30.0.0",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "autoprefixer": "^10.6.1",
    "copy-webpack-plugin": "^14.0.0",
    "dotenv": "^18.0.9",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "5.0.5",
    "webpack": "^5.112.2"
  }
}
